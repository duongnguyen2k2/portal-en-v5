@model API.Models.Home.PartialNewFeatured
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer Localizer

@{
    // Get organization ID from session
    var domainId = Context.Session.GetString("DomainId");
    if (string.IsNullOrEmpty(domainId))
    {
        <div class="alert alert-warning">Session expired. Please log in again.</div>
        return;
    }

    int organizationId = int.Parse(domainId);

    // Fetch data
    var hotArticles = API.Areas.Admin.Models.Articles.ArticlesService.GetListHot(organizationId)
                      ?? new List<API.Areas.Admin.Models.Articles.Articles>();
    var notifications = API.Areas.Admin.Models.Articles.ArticlesService.GetListNotification(organizationId)
                        ?? new List<API.Areas.Admin.Models.Articles.Articles>();

    bool hasHotArticles = hotArticles.Any();
    bool hasNotifications = notifications.Any();
}

<div class="modern-features-wrapper">
    <div class="features-grid">
        <!-- Hot News Section -->
        <div class="hot-news-section">
            <div class="section-header">
                <div class="header-content">
                    <i class="fas fa-fire-alt header-icon"></i>
                    <h2 class="section-title">
                        <a asp-controller="Articles" asp-action="Featured">
                            @Localizer["HotNews"]
                        </a>
                    </h2>
                </div>
                <div class="header-decoration"></div>
            </div>

            @if (hasHotArticles)
            {
                <div class="hot-news-content">
                    <!-- Featured Article Carousel -->
                    <div class="featured-carousel-wrapper">
                        <div id="featuredCarousel" class="carousel slide carousel-fade" data-ride="carousel" data-interval="5000">
                            <div class="carousel-inner">
                                @foreach (var (article, index) in hotArticles.Select((a, i) => (a, i)))
                                {
                                    <div class="carousel-item @(index == 0 ? "active" : "")">
                                        <div class="featured-article-card">
                                            <a asp-controller="Articles"
                                               asp-action="Detail"
                                               asp-route-id="@article.Id"
                                               asp-route-alias="@article.Alias"
                                               class="featured-image-link">
                                                <div class="image-container">
                                                    <img src="@article.Images"
                                                         alt="@article.Title"
                                                         class="featured-image"
                                                         loading="lazy" />
                                                    <div class="image-overlay">
                                                        <span class="read-more-badge">
                                                            <i class="fas fa-arrow-right"></i> Read More
                                                        </span>
                                                    </div>
                                                </div>
                                            </a>
                                            <div class="featured-content">
                                                <span class="featured-badge">
                                                    <i class="fas fa-star"></i> Featured
                                                </span>
                                                <h3 class="featured-title">
                                                    <a asp-controller="Articles"
                                                       asp-action="Detail"
                                                       asp-route-id="@article.Id"
                                                       asp-route-alias="@article.Alias">
                                                        @article.Title
                                                    </a>
                                                </h3>
                                                <p class="featured-excerpt">
                                                    @Html.Raw(API.Models.MyHelper.StringHelper.StringReadmore(article.IntroText, 180))
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (hotArticles.Count > 1)
                            {
                                <div class="carousel-indicators-custom">
                                    @for (int i = 0; i < hotArticles.Count; i++)
                                    {
                                        <button type="button"
                                                data-target="#featuredCarousel"
                                                data-slide-to="@i"
                                                class="@(i == 0 ? "active" : "")"
                                                aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>

                                <button class="carousel-control-prev" type="button" data-target="#featuredCarousel" data-slide="prev">
                                    <span class="carousel-control-icon"><i class="fas fa-chevron-left"></i></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-target="#featuredCarousel" data-slide="next">
                                    <span class="carousel-control-icon"><i class="fas fa-chevron-right"></i></span>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Articles List -->
                    <div class="articles-list-wrapper">
                        <div class="articles-list-scroll">
                            @foreach (var (article, index) in hotArticles.Select((a, i) => (a, i)))
                            {
                                <div class="article-list-item @(index == 0 ? "featured-item" : "")">
                                    <a asp-controller="Articles"
                                       asp-action="Detail"
                                       asp-route-id="@article.Id"
                                       asp-route-alias="@article.Alias"
                                       class="article-list-link">
                                        @if (index == 0)
                                        {
                                            <div class="article-thumbnail">
                                                <img src="@article.Images" alt="@article.Title" loading="lazy" />
                                                <div class="thumbnail-overlay">
                                                    <i class="fas fa-play-circle"></i>
                                                </div>
                                            </div>
                                        }
                                        <div class="article-list-content">
                                            <span class="article-number">@(index + 1)</span>
                                            <h4 class="article-list-title">@article.Title</h4>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-inbox empty-icon"></i>
                    <p>@Localizer["NoHotNewsAvailable"]</p>
                </div>
            }
        </div>

        <!-- Notifications Section -->
        <div class="notifications-section">
            <div class="section-header">
                <div class="header-content">
                    <i class="fas fa-bell header-icon"></i>
                    <h2 class="section-title">
                        <a asp-controller="Articles" asp-action="Notification">
                            @Localizer["Notification"]
                        </a>
                    </h2>
                </div>
                <div class="header-decoration"></div>
            </div>

            <div class="notifications-content">
                @if (hasNotifications)
                {
                    <div class="notifications-scroll">
                        @foreach (var (notification, index) in notifications.Select((n, i) => (n, i)))
                        {
                            <div class="notification-card" style="animation-delay: @(index * 0.1)s">
                                <div class="notification-indicator"></div>
                                <a asp-controller="Articles"
                                   asp-action="Detail"
                                   asp-route-id="@notification.Id"
                                   asp-route-alias="@notification.Alias"
                                   class="notification-link">
                                    <div class="notification-content">
                                        <h4 class="notification-title">@notification.Title</h4>
                                        <div class="notification-meta">
                                            <span class="notification-date">
                                                <i class="far fa-clock"></i>
                                                @notification.PublishUp.ToString("dd/MM/yyyy")
                                            </span>
                                            <span class="notification-time">
                                                @notification.PublishUp.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="notification-arrow">
                                        <i class="fas fa-chevron-right"></i>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-inbox empty-icon"></i>
                        <p>@Localizer["NoNotificationsAvailable"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>